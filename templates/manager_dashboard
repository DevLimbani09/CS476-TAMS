<body class="TAMS-app page-manager-dashboard" data-page="manager_dashboard">
    <!-- Shared Sidebar -->
    <aside class="TAMS-sidebar" aria-label="Main navigation">
        <div class="TAMS-sidebar__brand"><a href="../shared/dashboard.html">TAMS</a></div>
        <nav class="TAMS-sidebar__nav" aria-label="Primary">
            <ul class="TAMS-sidebar__list">
